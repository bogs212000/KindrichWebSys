rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/main {
      allow read, write: if true;
    }
    match /projects/{projectId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /logs/{logId} {
      allow read, write: if true;
    }
    match /settings/expenseCategories {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}