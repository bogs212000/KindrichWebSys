{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.rules.migration-draft",
      "SECURITY_MIGRATION.md",
      "AUDIT_REPORT.md",
      "tests/**",
      "tools/**",
      "normalized-migration-manifest.json",
      "package*.json",
      "firebase.emulator.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "predeploy": ["node tools/firestore-deploy-guard.js"]
  }
}
